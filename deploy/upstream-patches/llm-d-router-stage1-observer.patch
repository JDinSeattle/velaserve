diff --git a/pkg/epp/requestcontrol/velaserve_observer.go b/pkg/epp/requestcontrol/velaserve_observer.go
new file mode 100644
index 00000000..6eb7f422
--- /dev/null
+++ b/pkg/epp/requestcontrol/velaserve_observer.go
@@ -0,0 +1,206 @@
+package requestcontrol
+
+import (
+	"encoding/json"
+	"fmt"
+	"net"
+	"os"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/llm-d/llm-d-router/pkg/common/routing"
+	fwksched "github.com/llm-d/llm-d-router/pkg/epp/framework/interface/scheduling"
+	attrprefix "github.com/llm-d/llm-d-router/pkg/epp/framework/plugins/datalayer/attribute/prefix"
+)
+
+const (
+	velaVersionHeader     = "x-vela-fanout-version"
+	velaGroupHeader       = "x-vela-fanout-group"
+	velaPrefixProducer    = "precise-prefix-cache-producer"
+	velaSourceIDHeader    = "x-velaserve-p2p-source-id"
+	velaSourceModelHeader = "x-velaserve-p2p-source-model"
+)
+
+var velaRecordLock sync.Mutex
+
+type velaEndpointRef struct {
+	ID    string `json:"id"`
+	Model string `json:"model"`
+	Zone  string `json:"zone,omitempty"`
+}
+
+type velaPrefixSource struct {
+	Source        velaEndpointRef `json:"source"`
+	CachedTokens  uint64          `json:"cached_tokens"`
+	TransferBytes uint64          `json:"transfer_bytes"`
+}
+
+type velaEndpointScore struct {
+	Endpoint velaEndpointRef `json:"endpoint"`
+	Score    float64         `json:"score"`
+}
+
+type velaEndpointState struct {
+	Ref                 velaEndpointRef    `json:"ref"`
+	Healthy             bool               `json:"healthy"`
+	Compatible          bool               `json:"compatible"`
+	AvailableAtSeconds  float64            `json:"available_at_seconds"`
+	QueueDepth          uint32             `json:"queue_depth"`
+	RunningRequests     uint32             `json:"running_requests"`
+	LocalPrefixTokens   uint64             `json:"local_prefix_tokens"`
+	SourcePrefixTokens  uint64             `json:"source_prefix_tokens"`
+	ObservedInflight    uint32             `json:"observed_inflight"`
+	InflightPublishedAt *time.Time         `json:"inflight_published_at,omitempty"`
+	P2PSources          []velaPrefixSource `json:"p2p_sources,omitempty"`
+}
+
+type velaSnapshot struct {
+	ObservedAt time.Time           `json:"observed_at"`
+	Endpoints  []velaEndpointState `json:"endpoints"`
+}
+
+type velaRecord struct {
+	SchemaVersion     string              `json:"schema_version"`
+	RequestID         string              `json:"request_id"`
+	GroupID           string              `json:"group_id"`
+	ObservedAt        time.Time           `json:"observed_at"`
+	Snapshot          velaSnapshot        `json:"snapshot"`
+	Target            velaEndpointRef     `json:"target"`
+	TargetHost        string              `json:"target_host"`
+	ScoredCandidates  []velaEndpointScore `json:"scored_candidates,omitempty"`
+	SelectedP2PSource *velaPrefixSource   `json:"selected_p2p_source,omitempty"`
+	SelectedP2PSourceHost string          `json:"selected_p2p_source_host,omitempty"`
+	SelectedP2PSourcePort uint32          `json:"selected_p2p_source_port,omitempty"`
+}
+
+func recordVelaServeScheduling(request *fwksched.InferenceRequest, result *fwksched.SchedulingResult, candidates []fwksched.Endpoint) {
+	if request == nil || result == nil || headerValue(request.Headers, velaVersionHeader) != "1" {
+		return
+	}
+	groupID := headerValue(request.Headers, velaGroupHeader)
+	primary := result.ProfileResults[result.PrimaryProfileName]
+	if groupID == "" || primary == nil || len(primary.TargetEndpoints) == 0 || primary.TargetEndpoints[0] == nil {
+		return
+	}
+	observedAt := time.Now().UTC()
+	states := make([]velaEndpointState, 0, len(candidates))
+	sourceTokens := make(map[string]uint64, len(candidates))
+	hosts := make(map[string]velaEndpointRef, len(candidates))
+	for _, endpoint := range candidates {
+		if endpoint == nil || endpoint.GetMetadata() == nil {
+			continue
+		}
+		ref := endpointRef(endpoint, request.TargetModel)
+		local, source := prefixTokens(endpoint)
+		sourceTokens[ref.ID] = source
+		metadata := endpoint.GetMetadata()
+		hosts[net.JoinHostPort(metadata.Address, metadata.Port)] = ref
+		// candidates is the post-screener eligible set passed to the scheduler.
+		state := velaEndpointState{Ref: ref, Healthy: true, Compatible: true, LocalPrefixTokens: local, SourcePrefixTokens: source}
+		if metrics := endpoint.GetMetrics(); metrics != nil {
+			if metrics.WaitingQueueSize > 0 {
+				state.QueueDepth = uint32(metrics.WaitingQueueSize)
+			}
+			if metrics.RunningRequestsSize > 0 {
+				state.RunningRequests = uint32(metrics.RunningRequestsSize)
+				state.ObservedInflight = uint32(metrics.RunningRequestsSize)
+			}
+			if !metrics.UpdateTime.IsZero() {
+				published := metrics.UpdateTime.UTC()
+				state.InflightPublishedAt = &published
+			}
+		}
+		states = append(states, state)
+	}
+	target := endpointRef(primary.TargetEndpoints[0], request.TargetModel)
+	targetMetadata := primary.TargetEndpoints[0].GetMetadata()
+	targetHost := net.JoinHostPort(targetMetadata.Address, targetMetadata.Port)
+	delete(request.Headers, velaSourceIDHeader)
+	delete(request.Headers, velaSourceModelHeader)
+	// PrefixCacheMatchInfo is the per-request indexed eligibility view used by
+	// the pinned offloading scorer. Materialize every eligible remote CPU-tier
+	// source on every counterfactual compute target so offline replay does not
+	// confuse an unselected target with an unavailable P2P path.
+	for targetIndex := range states {
+		for _, sourceState := range states {
+			cachedTokens := sourceTokens[sourceState.Ref.ID]
+			if cachedTokens > 0 && sourceState.Ref != states[targetIndex].Ref {
+				states[targetIndex].P2PSources = append(states[targetIndex].P2PSources, velaPrefixSource{Source: sourceState.Ref, CachedTokens: cachedTokens})
+			}
+		}
+	}
+	var selected *velaPrefixSource
+	var selectedHost string
+	var selectedPort uint32
+	if sourceHostPort := strings.TrimSpace(request.Headers[routing.KVCacheSourceHeader]); sourceHostPort != "" {
+		sourceRef, exists := hosts[sourceHostPort]
+		if !exists || sourceTokens[sourceRef.ID] == 0 {
+			return
+		}
+		host, _, err := net.SplitHostPort(sourceHostPort)
+		if err != nil || strings.TrimSpace(host) == "" {
+			return
+		}
+		selected = &velaPrefixSource{Source: sourceRef, CachedTokens: sourceTokens[sourceRef.ID]}
+		selectedHost, selectedPort = host, 7777
+		request.Headers[velaSourceIDHeader] = sourceRef.ID
+		request.Headers[velaSourceModelHeader] = sourceRef.Model
+	}
+	scores := make([]velaEndpointScore, 0, len(primary.ScoredCandidates))
+	for _, scored := range primary.ScoredCandidates {
+		if scored.Endpoint == nil || scored.Endpoint.GetMetadata() == nil {
+			continue
+		}
+		scores = append(scores, velaEndpointScore{Endpoint: endpointRef(scored.Endpoint, request.TargetModel), Score: scored.Score})
+	}
+	record := velaRecord{
+		SchemaVersion: "velaserve.epp-scheduling/v1", RequestID: request.RequestID, GroupID: groupID,
+		ObservedAt: observedAt, Snapshot: velaSnapshot{ObservedAt: observedAt, Endpoints: states}, Target: target, TargetHost: targetHost,
+		ScoredCandidates: scores, SelectedP2PSource: selected, SelectedP2PSourceHost: selectedHost, SelectedP2PSourcePort: selectedPort,
+	}
+	encoded, err := json.Marshal(record)
+	if err != nil {
+		return
+	}
+	velaRecordLock.Lock()
+	defer velaRecordLock.Unlock()
+	_, _ = fmt.Fprintf(os.Stdout, "VELASERVE_EPP_RECORD %s\n", encoded)
+}
+
+func headerValue(headers map[string]string, name string) string {
+	for key, value := range headers {
+		if strings.EqualFold(key, name) {
+			return strings.TrimSpace(value)
+		}
+	}
+	return ""
+}
+
+func endpointRef(endpoint fwksched.Endpoint, model string) velaEndpointRef {
+	metadata := endpoint.GetMetadata()
+	id := metadata.Name
+	if id == "" {
+		id = metadata.ID.String()
+	}
+	return velaEndpointRef{ID: id, Model: model, Zone: metadata.Labels["topology.kubernetes.io/zone"]}
+}
+
+func prefixTokens(endpoint fwksched.Endpoint) (local, source uint64) {
+	key := attrprefix.PrefixCacheMatchInfoDataKey.WithNonEmptyProducerName(velaPrefixProducer)
+	raw, ok := endpoint.Get(key)
+	if !ok {
+		return 0, 0
+	}
+	info, ok := raw.(*attrprefix.PrefixCacheMatchInfo)
+	if !ok || info.BlockSizeTokens() <= 0 {
+		return 0, 0
+	}
+	local = uint64(info.CachedBlockCount() * info.BlockSizeTokens())
+	if tiers := info.CachedBlocksByTier(); tiers != nil {
+		source = uint64(tiers["cpu"] * info.BlockSizeTokens())
+	} else {
+		source = local
+	}
+	return local, source
+}
