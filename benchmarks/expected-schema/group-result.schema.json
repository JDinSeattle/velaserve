{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JDinSeattle/velaserve/schemas/group-result-v1.json",
  "title": "VelaServe group result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "arm", "group_id", "fanout_width", "makespan_seconds", "slowest_child_ttft_seconds", "cell", "outcome", "children"],
  "properties": {
    "schema_version": {"const": "velaserve.evidence/v1"},
    "run_id": {"type": "string", "minLength": 1},
    "arm": {"enum": ["arm-a-affinity-p2p", "arm-b-load-aware-p2p", "arm-c-velaserve-placement-p2p", "arm-d-load-aware-no-p2p", "arm-e-source-control-p2p", "offline-n-aware-oracle"]},
    "group_id": {"type": "string", "minLength": 1},
    "fanout_width": {"enum": [1, 2, 4, 8, 16]},
    "makespan_seconds": {"type": "number", "minimum": 0},
    "slowest_child_ttft_seconds": {"type": "number", "minimum": 0},
    "recomputed_prefix_tokens": {"type": "integer", "minimum": 0},
    "estimated_prefill_gpu_seconds": {"type": "number", "minimum": 0},
    "cell": {"$ref": "#/$defs/benchmarkCell"},
    "outcome": {"enum": ["success", "failure", "cancelled"]},
    "failure": {"type": "string", "minLength": 1},
    "children": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/child"}},
    "condition": {"$ref": "#/$defs/condition"},
    "condition_failure": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "benchmarkCell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repetition", "prefix_regime", "prefix_tokens", "output_regime", "max_tokens", "arrival_skew_ms", "load_regime", "cache_state", "transport", "epp_replicas"],
      "properties": {
        "repetition": {"type": "integer", "minimum": 1},
        "prefix_regime": {"type": "string", "minLength": 1},
        "prefix_tokens": {"type": "integer", "minimum": 1},
        "output_regime": {"type": "string", "minLength": 1},
        "max_tokens": {"type": "integer", "minimum": 1},
        "arrival_skew_ms": {"enum": [0, 1, 5, 20]},
        "load_regime": {"enum": ["idle", "moderate", "near-saturation"]},
        "cache_state": {"enum": ["warm-owner", "distributed-warm", "cold"]},
        "transport": {"type": "string", "minLength": 1},
        "epp_replicas": {"enum": [1, 2]}
      }
    },
    "endpointRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "model"],
      "properties": {"id": {"type": "string", "minLength": 1}, "model": {"type": "string", "minLength": 1}, "zone": {"type": "string"}}
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "run_id", "group_id", "load_regime", "cache_state", "owner_rotation", "controller_revision", "state_sha256", "observed_state", "applied_at", "finalized_at"],
      "properties": {
        "schema_version": {"const": "velaserve.condition-attestation/v1"},
        "run_id": {"type": "string", "minLength": 1},
        "group_id": {"type": "string", "minLength": 1},
        "load_regime": {"enum": ["idle", "moderate", "near-saturation"]},
        "cache_state": {"enum": ["warm-owner", "distributed-warm", "cold"]},
        "prefix_source_count": {"enum": [1, 2, 4]},
        "owner_rotation": {"type": "integer", "minimum": 0},
        "controller_revision": {"type": "string", "minLength": 1},
        "state_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "observed_state": {"$ref": "#/$defs/conditionObservedState"},
        "applied_at": {"type": "string", "format": "date-time"}
        ,"finalized_at": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "conditionObservedState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["offered_load_qps", "achieved_load_qps", "saturation_qps", "load_profile_sha256", "load_profiles_sha256", "load_calibration_sha256", "cached_endpoint_ids", "owner_endpoint_order", "drained_endpoint_ids", "drain_stable_samples", "dropped_load_requests", "ordinary_traffic_mean_latency_seconds", "measurement_source"],
      "properties": {
        "offered_load_qps": {"type": "number", "minimum": 0},
        "achieved_load_qps": {"type": "number", "minimum": 0},
        "saturation_qps": {"type": "number", "exclusiveMinimum": 0},
        "load_profile_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "load_profiles_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "load_calibration_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "cached_endpoint_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "owner_endpoint_order": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "drained_endpoint_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "drain_stable_samples": {"type": "integer", "minimum": 2},
        "dropped_load_requests": {"const": 0},
        "ordinary_traffic_mean_latency_seconds": {"type": "number", "minimum": 0},
        "prefix_source_endpoint_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "measurement_source": {"type": "string", "minLength": 1}
      }
    },
    "child": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "ttft_seconds", "latency_seconds", "output_tokens", "outcome", "completed_at"],
      "properties": {
        "request_id": {"type": "string", "minLength": 1},
        "target": {"$ref": "#/$defs/endpointRef"},
        "ttft_seconds": {"type": "number", "minimum": 0},
        "latency_seconds": {"type": "number", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "prompt_tokens": {"type": "integer", "minimum": 0},
        "cached_tokens": {"type": "integer", "minimum": 0},
        "outcome": {"enum": ["success", "failure", "cancelled"]},
        "failure": {"type": "string", "minLength": 1},
        "dispatched_at": {"type": "string", "format": "date-time"},
        "first_token_at": {"type": "string", "format": "date-time"},
        "completed_at": {"type": "string", "format": "date-time"}
      }
    }
  }
}
